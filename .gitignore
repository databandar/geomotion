# dependencies
node_modules

# build output
dist
.vite
*.tsbuildinfo

# secrets — never commit
.env.local
.env*.local

# turborepo cache
.turbo

# generated pipeline artifacts
apps/pipeline/out
apps/pipeline/scripts/_studio-*.json

# AI-generated per-slug illustrations: regenerable inputs, kept out of the repo
# to keep it lean. The convention itself is documented in apps/pipeline/assets/README.md.
apps/pipeline/assets/*/
!apps/pipeline/assets/README.md

# OS / editor
.DS_Store
*.swp

# Rendered episode output — reproducible from docs/brand/render/tools/, not versioned.
