        position: relative;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: #05060a;
        color: #f5efe2;
      }

      .disp {
        font-family: "League Gothic", sans-serif;
        font-weight: 400;
        letter-spacing: 0.005em;
      }
      .mono {
        font-family: "IBM Plex Mono", monospace;
      }
      .amber {
        color: #ffd23f;
      }

      /* soft vignette so the map reads as a backdrop, not a competing poster */
      #vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at center, rgba(5, 6, 10, 0) 30%, rgba(5, 6, 10, 0.55) 82%, rgba(5, 6, 10, 0.85) 100%);
        pointer-events: none;
      }

      /* ---------------- open: one clean line, bottom-left ---------------- */
      #open {
        position: absolute;
        left: 130px;
        bottom: 150px;
      }
      #open .num {
        display: inline-block;
        font-size: 170px;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        color: #fff6df;
        opacity: 0;
      }
      #open .suffix {
        display: inline-block;
        font-size: 96px;
        color: #ffd23f;
        opacity: 0;
        margin-left: 24px;
      }
      #open .label {
        margin-top: 40px;
        font-size: 42px;
        letter-spacing: 0.06em;
        color: rgba(245, 239, 226, 0.88);
        opacity: 0;
      }

      /* ---------------- city: minimal lower-left tick ---------------- */
      .city {
        position: absolute;
        left: 130px;
        bottom: 150px;
      }
      .city .line {
        display: flex;
        align-items: baseline;
        gap: 34px;
        opacity: 0;
      }
      .city .name {
        font-size: 120px;
        line-height: 1;
        color: #fff6df;
      }
      .city .pop {
        font-size: 72px;
        color: #ffd23f;
        font-variant-numeric: tabular-nums;
      }
      .city .rule {
        position: absolute;
        top: -30px;
        left: 0;
        width: 0;
        height: 3px;
        background: #ffd23f;
      }

      /* ---------------- close: one statement, then kicker ---------------- */
      #close {
        position: absolute;
        left: 130px;
        bottom: 170px;
        width: 1400px;
      }
      #close .big {
        font-size: 130px;
        line-height: 1.02;
        color: #fff6df;
        opacity: 0;
      }
      #close .big .amber {
        color: #ffd23f;
      }
      #close .kicker {
        margin-top: 46px;
        font-size: 52px;
        letter-spacing: 0.12em;
        color: #ffd23f;
        opacity: 0;
      }
    </style>
