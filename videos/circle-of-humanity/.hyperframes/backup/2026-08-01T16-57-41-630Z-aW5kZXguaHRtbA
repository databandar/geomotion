    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      /* ---- open: count up, then the label ---- */
      const openState = { value: 0 };
      const openNum = document.getElementById("open-num");
      tl.to(openState, {
        value: 8000000000,
        duration: 1.5,
        ease: "power2.inOut",
        onUpdate: () => {
          openNum.textContent = Math.round(openState.value).toLocaleString();
        },
      }, 0.9);
      tl.to("#open-num", { opacity: 1, duration: 0.4, ease: "power1.out" }, 0.6);
      tl.to("#open-suffix", { opacity: 1, duration: 0.5, ease: "power1.out" }, 1.6);
      tl.to("#open-label", { opacity: 1, duration: 0.6, ease: "power1.out" }, 2.6);

      /* ---- cities: name crossfades + a short amber rule draws on ---- */
      function city(id, at) {
        const name = document.getElementById(id + "-name");
        const num = document.getElementById(id + "-num");
        tl.to("#" + id + "-rule", { width: 64, duration: 0.4, ease: "power2.out" }, at + 0.05);
        tl.fromTo(name, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, at + 0.12);
        tl.fromTo(num, { opacity: 0 }, { opacity: 1, duration: 0.5, ease: "power1.out" }, at + 0.35);
      }
      city("c1", 5.85);
      city("c2", 8.35);
      city("c3", 10.85);
      city("c4", 13.35);
      city("c5", 15.85);
      city("c6", 18.35);
      city("c7", 20.85);
      city("c8", 23.35);

      /* ---- close: one statement, then kicker ---- */
      tl.to("#close .big", { opacity: 1, duration: 0.7, ease: "power1.out" }, 25.6);
      tl.to("#cl-kicker", { opacity: 1, duration: 0.6, ease: "power1.out" }, 27.2);

      window.__timelines["main"] = tl;
    </script>
