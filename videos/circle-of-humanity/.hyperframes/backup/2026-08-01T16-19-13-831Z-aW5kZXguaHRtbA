        <div data-hf-id="hf-ubk1" class="name" id="c6-name">KARACHI</div>
        <div data-hf-id="hf-6s5u" class="pop" id="c6-pop"><span data-hf-id="hf-1htq" id="c6-num">0</span><span data-hf-id="hf-d1yy" class="m"> million</span></div>
