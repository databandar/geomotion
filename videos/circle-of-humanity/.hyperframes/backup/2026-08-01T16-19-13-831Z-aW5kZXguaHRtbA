      <audio data-hf-id="hf-emdk" id="vo-9" src="assets/vo-9.wav" data-start="23.3" data-duration="2.3" data-track-index="18" data-volume="1"></audio>
      <audio data-hf-id="hf-zh8e" id="vo-10" src="assets/vo-10.wav" data-start="25.7" data-duration="5.1" data-track-index="19" data-volume="1"></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      tl.set("#cl-sub", { x: 0, y: 0, data: "hf-hold" }, 0);
      const F = 1 / 60;

      tl.to("#glow", { scale: 1.06, duration: 2.4, ease: "sine.inOut", yoyo: true, repeat: 6 }, 0);

      /* ---- open stat: count up 8,000,000,000 ---- */
      const openState = { value: 0 };
      const openNum = document.getElementById("open-num");
      tl.fromTo(openNum, { scale: 0.5 }, { scale: 1, duration: 1.6, ease: "power3.out" }, 0.7);
      tl.to(openState, {
        value: 8000000000,
        duration: 1.6,
        ease: "power3.out",
        onUpdate: () => {
          openNum.textContent = Math.round(openState.value).toLocaleString();
        },
      }, 0.7);
      tl.fromTo(openNum, { opacity: 0 }, { opacity: 1, duration: 0.4 }, 0.5);
      tl.to("#open-suffix", { opacity: 1, y: 0, duration: 0.5, ease: "back.out(1.7)" }, 2.3);
      tl.to("#open-label", { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 3.2);

      /* ---- city punch-ins: name slams, population counts up ---- */
      function city(id, at, pop) {
        const name = document.getElementById(id + "-name");
        const num = document.getElementById(id + "-num");
        const st = { value: 0 };
        tl.fromTo(name, { opacity: 0, scale: 1.6, filter: "blur(10px)" }, { opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.4, ease: "power4.out" }, at);
        tl.fromTo(num, { opacity: 0 }, { opacity: 1, duration: 0.3 }, at + 0.25);
        tl.to(st, {
          value: pop,
          duration: 0.55,
          ease: "power3.out",
          onUpdate: () => {
            num.textContent = Math.round(st.value).toLocaleString();
          },
        }, at + 0.3);
      }
      city("c1", 5.85, 37);
      city("c2", 8.35, 31);
      city("c3", 10.85, 28);
      city("c4", 13.35, 21);
      city("c5", 15.85, 22);
      city("c6", 18.35, 16);
      city("c7", 20.85, 11);
      city("c8", 23.35, 13);

      /* ---- close ---- */
      tl.fromTo("#cl-big", { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.6, ease: "power4.out" }, 25.3);

      tl.fromTo("#cl-sub", { opacity: 0 }, { opacity: 1, duration: 0.5, ease: "power4.out" }, 27);

      tl.to("#cl-sub", { keyframes: { "0%": { x: 0, y: 0 }, "13.2%": { x: 0, y: 0 }, "100%": { x: -21, y: 282 } }, duration: 3.8 }, 27);

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
