<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1920, height=1080">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: #05060a;
      }
      body {
        font-family: "IBM Plex Mono", monospace;
      }
      #root {
        position: relative;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: #05060a;
        color: #f5efe2;
      }

      .disp {
        font-family: "League Gothic", sans-serif;
        font-weight: 400;
        letter-spacing: 0.005em;
      }
      .mono {
        font-family: "IBM Plex Mono", monospace;
      }
      .amber {
        color: #ffd23f;
      }

      #glow {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1900px;
        height: 1900px;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, rgba(255, 210, 63, 0.16) 0%, rgba(255, 210, 63, 0.04) 40%, rgba(5, 6, 10, 0) 70%);
        border-radius: 50%;
      }

      /* ---- open stat ---- */
      #open {
        position: absolute;
        left: 0;
        right: 0;
        top: 330px;
        text-align: center;
      }
      #open .num {
        display: inline-block;
        font-size: 190px;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        color: #fff6df;
        text-shadow: 0 0 60px rgba(255, 210, 63, 0.35);
      }
      #open .suffix {
        font-size: 110px;
        color: #ffd23f;
        opacity: 0;
        transform: translateY(18px);
        display: inline-block;
      }
      #open .label {
        margin-top: 52px;
        font-size: 46px;
        letter-spacing: 0.12em;
        color: #ffd23f;
        opacity: 0;
      }

      /* ---- city punch-in ---- */
      .city {
        position: absolute;
        right: 120px;
        top: 250px;
        width: 700px;
        text-align: right;
      }
      .city .name {
        font-size: 130px;
        line-height: 0.95;
        color: #fff6df;
        opacity: 0;
      }
      .city .pop {
        font-size: 90px;
        color: #ffd23f;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        margin-top: 30px;
        opacity: 0;
      }
      .city .pop .m {
        font-size: 46px;
        letter-spacing: 0.1em;
      }

      /* ---- close ---- */
      #close {
        position: absolute;
        left: 0;
        right: 0;
        top: 300px;
        text-align: center;
      }
      #close .big {
        font-size: 120px;
        line-height: 1;
        color: #fff6df;
        opacity: 0;
      }
      #close .sub {
        margin-top: 56px;
        font-size: 60px;
        letter-spacing: 0.1em;
        color: #ffd23f;
        opacity: 0;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-zxm1" id="root" data-composition-id="main" data-start="0" data-duration="30.8" data-width="1920" data-height="1080">
      <video data-hf-id="hf-k16h" id="plate" src="assets/plate.mp4" data-start="0" data-duration="30.8" data-track-index="0" muted playsinline></video>
      <div data-hf-id="hf-27c6" id="glow"></div>

      <!-- open stat 0.5 - 5.8 -->
