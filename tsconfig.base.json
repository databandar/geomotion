{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": [
    "ENGINEERING_GUIDE §2: strict everywhere, including noUncheckedIndexedAccess and",
    "exactOptionalPropertyTypes. Every workspace project inherits this and none overrides",
    "it — keep it that way. An exemption here is how a codebase quietly stops being strict."
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
